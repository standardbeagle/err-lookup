---
import Base from "../layouts/Base.astro";
import { getManifest } from "../data/load.js";
const m = getManifest();
const examples = [
  { path: "/data/manifest.json", desc: "Freshness poll target. Tiny. MCP checks this first." },
  { path: "/data/index.json", desc: "Compact search index — one record per error, all repos." },
  { path: "/data/repos.json", desc: "RepoEntry[] — the list of analyzed repos." },
  { path: "/data/repos/{owner}/{name}.json", desc: "Full ErrorEntry[] for one repo." },
  { path: "/data/errors/{id}.json", desc: "A single full ErrorEntry record." },
];
---
<Base title="API & Dataset — ErrLookup" description="The static JSON dataset is the contract between the site and the MCP server.">
  <h1>Dataset contract</h1>
  <p>The product is structured data. The site is the distribution channel. Everything below is served as immutable static JSON at <code>https://errors.standardbeagle.com/data/…</code>.</p>

  <h2>Files</h2>
  <table>
    <thead><tr><th>Path</th><th>Purpose</th></tr></thead>
    <tbody>
      {examples.map((x) => <tr><td><code>{x.path}</code></td><td>{x.desc}</td></tr>)}
    </tbody>
  </table>

  <h2>Current dataset</h2>
  <pre>{
    JSON.stringify(m, null, 2)
  }</pre>

  <h2>Schema</h2>
  <p>JSON Schema (Draft-07): <a href="https://errors.standardbeagle.com/schema.json">/schema.json</a>. TypeScript types: <code>@errlookup/schema</code>. Every record validates on write, on read (build), and on download (MCP). Fail fast; never silently coerce.</p>

  <h2>Cache headers</h2>
  <pre>{`/data/manifest.json
  Cache-Control: public, max-age=300
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800`}</pre>
</Base>
