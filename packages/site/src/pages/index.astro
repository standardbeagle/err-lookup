---
import Base from "../layouts/Base.astro";
import RepoTable from "../components/RepoTable.astro";
import { getManifest } from "../data/load.js";
import { getRepoPage } from "../data/paging.js";
const manifest = getManifest();
// Page 1 of the analyzed-repos list; /repos/2/ onward carry the rest.
const page = getRepoPage(1);
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ErrLookup",
  url: "https://errors.standardbeagle.com",
  description:
    "Machine-consumable error knowledge base for open-source libraries: what every error means, why it happens, and how to fix it.",
  publisher: {
    "@type": "Organization",
    name: "Standard Beagle Studio",
    url: "https://standardbeagle.com",
  },
});
---
<Base title="ErrLookup — Know what every open-source error means" description="Structured knowledge base of errors thrown by popular open-source libraries: exact messages, causes, ordered fixes, and defensive patterns. MCP server for AI agents + static JSON dataset.">
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <h1>Know what every error means, and how to fix it.</h1>
  <p class="lead">ErrLookup reads library source and documents every user-facing error: exact message, cause, ordered fixes, defensive patterns. Built for coding agents, answer engines, and humans.</p>

  <div class="actions">
    <a class="btn" href="/troubleshooting/#install">Install the MCP server</a>
    <a class="btn-ghost" href="/request-crawl/">Request a library</a>
  </div>

  <div class="stats">
    <div><b>{manifest.counts.errors.toLocaleString()}</b><span>errors documented</span></div>
    <div><b>{manifest.counts.repos}</b><span>repositories</span></div>
    <div><b>{manifest.datasetVersion.slice(0, 10)}</b><span>dataset version</span></div>
  </div>

  <p class="muted">
    New here? The <a href="/troubleshooting/">troubleshooting page</a> collects the failure-class
    guides, a demo of the MCP server fixing a real error, and the agent install block.
  </p>

  <h2>Analyzed repos</h2>
  <p class="muted">
    {manifest.counts.repos.toLocaleString()} repositories, most-documented first
    {page.totalPages > 1 && <> — page {page.page} of {page.totalPages}</>}.
  </p>
  <RepoTable page={page} />
  <p>Missing a library you depend on? <a href="/request-crawl/">Request a crawl</a>.</p>

  <p class="muted">Honest provenance: every record is AI-assisted analysis of the cited commit, pinned to its SHA. See <a href="/about/">how records are made</a> and the <a href="/api-docs/">dataset contract</a>.</p>

  <p>If you like this project, please <a href="https://github.com/standardbeagle/err-lookup" target="_blank" rel="noopener noreferrer">star it on GitHub</a> — it helps other people find it.</p>
</Base>
