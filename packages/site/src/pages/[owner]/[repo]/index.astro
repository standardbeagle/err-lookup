---
import Base from "../../../layouts/Base.astro";
import { getRepoErrors, getRepos } from "../../../data/load.js";
import { repoOg } from "../../../data/og.js";

export function getStaticPaths() {
  return getRepos().map((r) => {
    const [owner, name] = r.repo.split("/");
    return { params: { owner, repo: name }, props: { repo: r } };
  });
}

const { repo } = Astro.props;
const errors = getRepoErrors(repo.repo);
const title = `${repo.repo} — ErrLookup`;
const SITE = "https://errors.standardbeagle.com";
// Breadcrumb only: the repo page is an index, so a trail is the useful signal.
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ErrLookup", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: repo.repo, item: `${SITE}/${repo.repo}/` },
  ],
});
---
<Base ogImage={repoOg(repo.repo)} title={title} description={`Error index for ${repo.repo}: ${repo.errorCount} documented errors.`}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <p class="muted"><a href="/">ErrLookup</a> › {repo.repo}</p>
  <h1>{repo.repo}</h1>
  <p class="muted">{repo.description ?? ""} · {repo.language ?? "—"} · {repo.sourceFiles != null ? `${repo.sourceFiles.toLocaleString()} source files` : "source files not counted"}</p>
  <p class="muted">Analyzed at <code>{repo.analyzedSha.slice(0, 10)}</code> on {repo.analyzedAt.slice(0, 10)}. {errors.length} documented errors.</p>

  <table>
    <thead><tr><th>Code / Message</th><th>Type</th><th>Severity</th><th>Tags</th></tr></thead>
    <tbody>
      {errors.map((e) => (
        <tr>
          <td>
            <a href={`/${repo.repo}/${e.slug}/`}>
              {e.errorCode ? <code>{e.errorCode}</code> : <span>{e.errorMessage.slice(0, 60)}</span>}
            </a>
            <div class="muted">{e.errorCode ? e.errorMessage.slice(0, 80) : ""}</div>
          </td>
          <td>{e.errorType}</td>
          <td><span class="pill">{e.severity}</span></td>
          <td class="muted">{e.tags.join(", ")}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
