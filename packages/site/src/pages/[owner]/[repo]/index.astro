---
import Base from "../../../layouts/Base.astro";
import { getRepoErrors, getRepos, getPublishedRepos } from "../../../data/load.js";
import { repoOg } from "../../../data/og.js";

// Every repo gets a page (site search and the API link here), but only repos
// the scheduled publisher has admitted are indexable — the props carry the
// verdict because getStaticPaths is the only build-time hook this route has.
export function getStaticPaths() {
  const published = getPublishedRepos();
  return getRepos().map((r) => {
    const [owner, name] = r.repo.split("/");
    return {
      params: { owner, repo: name },
      props: { repo: r, published: published === null || published.has(r.repo) },
    };
  });
}

const { repo, published } = Astro.props;
const errors = getRepoErrors(repo.repo);
const title = `${repo.repo} — ErrLookup`;
const SITE = "https://errors.standardbeagle.com";
// Breadcrumb only: the repo page is an index, so a trail is the useful signal.
const ld = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ErrLookup", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: repo.repo, item: `${SITE}/${repo.repo}/` },
  ],
});
---
<Base ogImage={repoOg(repo.repo)} title={title} description={`Error index for ${repo.repo}: ${repo.errorCount} documented errors.`} noindex={!published}>
  <script slot="head" type="application/ld+json" set:html={ld} />
  <p class="muted"><a href="/">ErrLookup</a> › {repo.repo}</p>

  {/* Retired-slug redirects land here with ?reason=...&from=<slug>. The page
      is prerendered, so the notice renders client-side from the query string.
      Unknown reason values stay silent; the notice is plain text (textContent)
      so the query string cannot inject markup. */}
  <div id="redirect-notice" hidden style="border: 1px solid var(--line); border-left: 4px solid var(--accent); background: var(--card); border-radius: 8px; padding: var(--s2); margin: var(--s2) 0; max-width: var(--measure);"></div>
  {/* is:inline — plain JS outside the build graph: processed as a Vite module
      this script shuffled Astro's chunk graph and the production build died
      with "Unable to find the module for src/pages/info/index.astro". */}
  <script is:inline>
    (function () {
      var REASONS = {
        removed: function (from) {
          return (
            (from ? 'The page "' + from + '" is no longer published. ' : "The page you followed is no longer published. ") +
            "A newer analysis of this repository retired that record — its error may have been renamed, merged into another entry, or removed from the source. The repository's current error index is below."
          );
        },
      };
      var params = new URLSearchParams(location.search);
      var build = REASONS[params.get("reason") || ""];
      if (build) {
        var el = document.getElementById("redirect-notice");
        el.textContent = build(params.get("from") || "");
        el.hidden = false;
      }
    })();
  </script>

  <h1>{repo.repo}</h1>
  <p class="muted">{repo.description ?? ""} · {repo.language ?? "—"} · {repo.sourceFiles != null ? `${repo.sourceFiles.toLocaleString()} source files` : "source files not counted"}</p>
  <p class="muted">Analyzed at <code>{repo.analyzedSha.slice(0, 10)}</code> on {repo.analyzedAt.slice(0, 10)}. {errors.length} documented errors.</p>

  <table>
    <thead><tr><th>Code / Message</th><th>Type</th><th>Severity</th><th>Tags</th></tr></thead>
    <tbody>
      {errors.map((e) => (
        <tr>
          <td>
            <a href={`/${repo.repo}/${e.slug}/`}>
              {e.errorCode ? <code>{e.errorCode}</code> : <span>{e.errorMessage.slice(0, 60)}</span>}
            </a>
            <div class="muted">{e.errorCode ? e.errorMessage.slice(0, 80) : ""}</div>
          </td>
          <td>{e.errorType}</td>
          <td><span class="pill">{e.severity}</span></td>
          <td class="muted">{e.tags.join(", ")}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
