---
import Base from "../../layouts/Base.astro";
import { postsByDate } from "../../data/blog.js";
const posts = postsByDate();
---
<Base
  title="Blog — ErrLookup"
  description="Engineering notes from ErrLookup: how the scanner works, self-hosting for internal repos, and error lookup for compiled languages."
>
  <h1>Blog</h1>
  <p class="lead">Engineering notes on building and using a machine-consumable error knowledge base.</p>
  {posts.map((p) => (
    <article style="margin: var(--s4) 0;">
      <h2 style="margin-bottom: .2rem;"><a href={`/blog/${p.slug}/`}>{p.title}</a></h2>
      <p class="muted" style="margin-top: 0;">{p.date}</p>
      <p>{p.description}</p>
    </article>
  ))}
</Base>
