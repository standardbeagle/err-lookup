---
const { title, description, canonical } = Astro.props;
const fullTitle = title ?? "ErrLookup";
const SITE = "https://errors.standardbeagle.com";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="ErrLookup" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <style>
      :root {
        --maxw: 760px;
        --ink: #241c15;
        --mute: #6b5d52;
        --line: #eadfd5;
        --accent: #c2410c;         /* standardbeagle burnt orange */
        --accent-ink: #9a3412;
        --wash: #faf6f1;           /* warm paper */
        --card: #fff;
        --pill-bg: #fef0e6;
        --pill-ink: #9a3412;
        --pill-line: #f6d9c4;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #ece4dc; --mute: #b3a396; --line: #3d332b;
          --accent: #fb923c; --accent-ink: #fdba74;
          --wash: #191410; --card: #221b16;
          --pill-bg: #33231a; --pill-ink: #fdba74; --pill-line: #4a3527;
        }
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji";
        color: var(--ink); line-height: 1.55; font-size: 16px; background: var(--wash);
      }
      main { max-width: var(--maxw); margin: 0 auto; padding: 1.5rem 1.1rem 3rem; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; color: var(--accent-ink); }
      h1 { font-size: 1.7rem; line-height: 1.2; margin: 1.2rem 0 .6rem; letter-spacing: -0.01em; }
      h2 { font-size: 1.2rem; margin: 1.6rem 0 .4rem; }
      pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
      pre { background: var(--card); border:1px solid var(--line); padding:.8rem; overflow:auto; border-radius:8px; font-size:.85rem; }
      code { font-size: .9em; }
      .muted { color: var(--mute); font-size: .9rem; }
      table { width:100%; border-collapse: collapse; margin:.6rem 0; font-size:.92rem; }
      th, td { text-align:left; padding:.45rem .5rem; border-bottom:1px solid var(--line); vertical-align: top; }
      nav.top { border-bottom:2px solid var(--accent); background: var(--card); }
      nav.top div { max-width:var(--maxw); margin:0 auto; padding:.7rem 1.1rem; display:flex; gap:1rem; align-items:center; flex-wrap:wrap; }
      nav.top a.brand { font-weight:800; color:var(--ink); display:flex; align-items:center; gap:.45rem; }
      nav.top a.brand svg { flex:none; }
      nav.top a { font-size:.95rem; }
      details { margin:.5rem 0; border:1px solid var(--line); border-radius:8px; padding:.5rem .8rem; background: var(--card); }
      summary { cursor:pointer; font-weight:600; }
      .pill { display:inline-block; font-size:.72rem; padding:.1rem .45rem; border-radius:99px; background:var(--pill-bg); color:var(--pill-ink); border:1px solid var(--pill-line); }
      footer.site { border-top:1px solid var(--line); margin-top:2rem; background: var(--card); }
      footer.site div { max-width:var(--maxw); margin:0 auto; padding:1.1rem; font-size:.85rem; color:var(--mute); display:flex; gap:1rem; flex-wrap:wrap; align-items:center; }
      footer.site a { color: var(--mute); text-decoration: underline; }
      footer.site a:hover { color: var(--accent); }
      .btn {
        display:inline-block; background:var(--accent); color:#fff !important; font-weight:600;
        padding:.5rem .9rem; border-radius:8px; border:none; font-size:.95rem; cursor:pointer;
      }
      .btn:hover { background:var(--accent-ink); text-decoration:none; }
      input[type="text"], textarea, select {
        width:100%; padding:.5rem .6rem; font:inherit; color:var(--ink);
        background:var(--card); border:1px solid var(--line); border-radius:8px;
      }
      label { font-weight:600; font-size:.92rem; display:block; margin:.9rem 0 .25rem; }
    </style>
  </head>
  <body>
    <nav class="top"><div>
      <a class="brand" href="/">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="#c2410c"/><circle cx="6.6" cy="8" r="1.5" fill="#fff"/><circle cx="13.4" cy="8" r="1.5" fill="#fff"/><path d="M6.5 12.5c1 1.4 2.2 2.1 3.5 2.1s2.5-.7 3.5-2.1" stroke="#fff" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg>
        ErrLookup
      </a>
      <a href="/about/">About</a>
      <a href="/request-crawl/">Request a crawl</a>
      <a href="/api-docs/">API &amp; Dataset</a>
      <a href="https://www.npmjs.com/package/@standardbeagle/errlookup-mcp">MCP</a>
    </div></nav>
    <main>
      <slot />
    </main>
    <footer class="site"><div>
      <span>Built by <a href="https://standardbeagle.com">Standard Beagle</a> — the AI UX agency for bold product teams.</span>
      <a href="/llms.txt">llms.txt</a>
      <a href="/data/manifest.json">dataset</a>
      <a href="https://github.com/standardbeagle/err-lookup">GitHub</a>
    </div></footer>
  </body>
</html>
