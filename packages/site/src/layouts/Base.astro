---
const { title, description, canonical, noCanonical, ogImage } = Astro.props;
const fullTitle = title ?? "ErrLookup";
const SITE = "https://errors.standardbeagle.com";
// noCanonical is for pages whose own URL is not a real address — the 404 body
// is served under every unmatched path, so a canonical (or og:url) derived from
// Astro.url would point a crawler at a URL that 404s in turn.
const canonicalUrl = noCanonical ? null : (canonical ?? new URL(Astro.url.pathname, SITE).href);
// Social cards must be absolute URLs — every scraper fetches them out of page
// context, so a root-relative path silently yields no preview at all.
const ogImageUrl = new URL(ogImage ?? "/og/default.png", SITE).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="ErrLookup" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="alternate" type="application/rss+xml" title="ErrLookup Blog" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <style is:global>
      :root {
        /* 8pt spacing scale */
        --s1: .5rem; --s2: 1rem; --s3: 1.5rem; --s4: 2rem; --s5: 3rem; --s6: 4rem;
        --maxw: 1120px;
        /* Prose stays readable while tables, code and cards use the full shell. */
        --measure: 70ch;
        /* warm standardbeagle palette — light */
        --ink: #241c15;
        --mute: #66584d;
        --line: #eadfd5;
        --accent: #c2410c;
        --accent-strong: #9a3412;
        --wash: #faf6f1;
        --card: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #ece4dc; --mute: #b3a396; --line: #3d332b;
          --accent: #fb923c; --accent-strong: #fdba74;
          --wash: #191410; --card: #221b16;
        }
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink); line-height: 1.6; font-size: 1rem; background: var(--wash);
      }
      main { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--s2) var(--s6); }
      /* A 1120px shell would run body text past 150 characters a line. Text
         blocks keep a comfortable measure; tables, code and video do not. */
      main > :is(p, ul, ol, h1, h2, h3, blockquote), details > :is(p, ul, ol) { max-width: var(--measure); }

      /* type scale — clear stops: 2.25 / 1.375 / 1; 1rem (16px) is the floor */
      h1 { font-size: 2.25rem; line-height: 1.15; font-weight: 800; letter-spacing: -0.015em; margin: var(--s5) 0 var(--s2); }
      h2 { font-size: 1.375rem; line-height: 1.3; font-weight: 700; margin: var(--s5) 0 var(--s1); }
      p { margin: var(--s1) 0 var(--s2); }
      .lead { font-size: 1.125rem; color: var(--mute); max-width: 56ch; }
      .muted { color: var(--mute); }

      a { color: var(--accent-strong); text-decoration: underline; text-underline-offset: 2px; }
      a:hover { color: var(--accent); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

      pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
      pre { background: var(--card); border: 1px solid var(--line); padding: var(--s2); overflow: auto; border-radius: 8px; margin: var(--s2) 0; }

      table { width: 100%; border-collapse: collapse; margin: var(--s2) 0; }
      th { text-transform: uppercase; letter-spacing: .04em; color: var(--mute); }
      th, td { text-align: left; padding: .55rem .5rem; border-bottom: 1px solid var(--line); vertical-align: top; }

      details { margin: var(--s1) 0; border: 1px solid var(--line); border-radius: 8px; padding: var(--s1) var(--s2); background: var(--card); }
      summary { cursor: pointer; font-weight: 600; padding: .25rem 0; }

      /* header: brand left, actions right; 44px targets */
      nav.top { background: var(--card); border-bottom: 1px solid var(--line); }
      nav.top > div {
        max-width: var(--maxw); margin: 0 auto; padding: .4rem var(--s2);
        display: flex; align-items: center; gap: var(--s1) var(--s2); flex-wrap: wrap;
      }
      /* Links group so they wrap as a unit instead of shedding one item at a
         time — the old bar left "MCP" and the GitHub mark stranded on row two. */
      nav.top .navlinks { display: flex; align-items: center; gap: .1rem; }
      /* 44x44 in BOTH axes — a 20px icon with 8px padding clears the height
         requirement while still being a 36px-wide tap target. */
      nav.top a { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 0 .6rem; text-decoration: none; color: var(--mute); }
      nav.top a.brand { min-width: 0; }
      nav.top a:hover { color: var(--accent-strong); }
      nav.top a.brand { font-weight: 800; font-size: 1.05rem; color: var(--ink); gap: .5rem; padding-left: 0; }

      /* header search: the primary action of the site — paste an error, get the
         record. Grows to fill the bar and pushes the nav links to the right. */
      .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        clip-path: inset(50%); white-space: nowrap; border: 0;
      }
      /* Keyboard users get a way past the header without tabbing every link. */
      .skip { position: absolute; left: var(--s2); top: -3rem; z-index: 10; transition: top .15s; }
      .skip:focus { top: var(--s1); }
      form.navsearch { display: flex; align-items: center; gap: .4rem; flex: 1 1 18rem; min-width: 11rem; }
      form.navsearch input {
        width: 100%; min-height: 44px; padding: .45rem .7rem; font: inherit; font-size: 1rem;
        color: var(--ink); background: var(--wash); border: 1px solid var(--line); border-radius: 8px;
      }
      form.navsearch input::placeholder { color: var(--mute); }
      form.navsearch input:focus { border-color: var(--accent); }
      form.navsearch button {
        min-height: 44px; padding: 0 .9rem; border-radius: 8px; border: 1px solid var(--line);
        background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer;
      }
      form.navsearch button:hover { background: var(--accent-strong); }
      @media (prefers-color-scheme: dark) { form.navsearch button { color: #1c0d02; } }
      /* Under ~820px there is no room for brand + search + links on one line.
         Search drops to its own full-width row rather than being squeezed to a
         box too small to hold an error message. */
      @media (max-width: 820px) {
        nav.top .navlinks { margin-left: auto; }
        form.navsearch { order: 99; flex-basis: 100%; margin: 0 0 .5rem; }
      }
      /* Narrow phones: the label text is what overflows first, so shrink the
         submit to its icon-free minimum and let links wrap freely. */
      @media (max-width: 380px) {
        nav.top a { padding: 0 .35rem; }
        form.navsearch button { padding: 0 .7rem; }
      }
      /* Table rows are the main navigation on repo and listing pages, so their
         links need thumb-sized rows on touch screens too. */
      @media (max-width: 600px) {
        th, td { padding: .8rem .5rem; }
        td a { display: inline-block; min-height: 24px; }
        /* A four-column table cannot fit a 320px screen. Let it scroll inside
           its own box — otherwise it drags the whole page sideways, which
           breaks every other element's layout as collateral. */
        main table { display: block; overflow-x: auto; }
      }
      nav.top a.gh { color: var(--mute); padding: 0 .5rem; }
      nav.top a.gh:hover { color: var(--ink); }

      footer.site { border-top: 1px solid var(--line); margin-top: var(--s6); background: var(--card); }
      footer.site > div { max-width: var(--maxw); margin: 0 auto; padding: var(--s3) var(--s2); color: var(--mute); display: flex; gap: var(--s2); flex-wrap: wrap; align-items: center; }
      footer.site a { color: var(--mute); }
      footer.site a:hover { color: var(--accent-strong); }

      /* actions: one primary per page; secondary is ghost (1.5:1 visual weight) */
      .btn, .btn-ghost {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 44px; padding: 0 var(--s3); border-radius: 8px;
        font-weight: 600; font-size: 1rem; text-decoration: none; cursor: pointer; border: 0;
      }
      .btn { background: var(--accent); color: #fff; }
      .btn:hover { background: var(--accent-strong); color: #fff; }
      @media (prefers-color-scheme: dark) {
        .btn { color: #1c0d02; }
        .btn:hover { color: #1c0d02; }
      }
      .btn-ghost { background: transparent; color: var(--accent-strong); border: 1.5px solid var(--line); }
      .btn-ghost:hover { border-color: var(--accent); }
      .actions { display: flex; gap: var(--s2); flex-wrap: wrap; margin: var(--s3) 0; }

      /* stat row: number dominates, label recedes */
      .stats { display: flex; gap: var(--s4); flex-wrap: wrap; margin: var(--s3) 0; }
      .stats b { display: block; font-size: 1.75rem; font-weight: 800; line-height: 1.1; }
      .stats span { text-transform: uppercase; letter-spacing: .05em; color: var(--mute); }

      input[type="text"], textarea, select {
        width: 100%; padding: .65rem .7rem; font: inherit; color: var(--ink);
        background: var(--card); border: 1px solid var(--line); border-radius: 8px;
      }
      label { font-weight: 600; display: block; margin: var(--s2) 0 .3rem; }

      .pill {
        display: inline-block; font-weight: 600; padding: .15rem .5rem;
        border-radius: 99px; background: var(--card); color: var(--accent-strong); border: 1px solid var(--line);
        text-transform: uppercase; letter-spacing: .03em;
      }

      /* search page form: same control, given room to hold a pasted stack line */
      form.pagesearch { display: flex; gap: var(--s1); margin: var(--s3) 0; flex-wrap: wrap; }
      form.pagesearch input {
        flex: 1 1 20rem; min-height: 44px; padding: .55rem .7rem; font: inherit;
        color: var(--ink); background: var(--card); border: 1px solid var(--line); border-radius: 8px;
      }
      form.pagesearch input:focus { border-color: var(--accent); }
      form.pagesearch button {
        min-height: 44px; padding: 0 var(--s3); border-radius: 8px; border: 0;
        background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer;
      }
      form.pagesearch button:hover { background: var(--accent-strong); }
      @media (prefers-color-scheme: dark) { form.pagesearch button { color: #1c0d02; } }

      /* pager: 44px targets, current page reads as a state not a link */
      nav.pager { display: flex; align-items: center; gap: var(--s1); flex-wrap: wrap; margin: var(--s2) 0 var(--s3); }
      nav.pager .nums { display: flex; align-items: center; gap: .15rem; margin: 0 auto; }
      nav.pager a, nav.pager .here, nav.pager .off {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 44px; min-width: 44px; padding: 0 .6rem; border-radius: 8px; text-decoration: none;
      }
      nav.pager a { color: var(--accent-strong); border: 1px solid var(--line); }
      nav.pager a:hover { border-color: var(--accent); color: var(--accent); }
      nav.pager .here { background: var(--accent); color: #fff; font-weight: 700; }
      @media (prefers-color-scheme: dark) { nav.pager .here { color: #1c0d02; } }
      nav.pager .off { color: var(--mute); opacity: .5; }
      nav.pager .gap { color: var(--mute); padding: 0 .2rem; }

      ul.criteria { list-style: none; padding: 0; margin: var(--s2) 0; }
      ul.criteria li { padding: .45rem 0 .45rem 1.4rem; position: relative; border-bottom: 1px solid var(--line); }
      ul.criteria li::before { content: ""; position: absolute; left: 0; top: .85rem; width: .55rem; height: .55rem; border-radius: 2px; background: var(--accent); }
      ul.criteria li.excluded::before { background: var(--line); }
      ul.criteria li.excluded { color: var(--mute); }
    </style>
    <!-- Cloudflare Web Analytics (RUM beacon). Complements the server-side
         Analytics Engine data: AE sees every worker-routed request including
         crawlers; this beacon sees only the human slice (JS-executing
         browsers) with Web Vitals. Site token is public by design. -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "a4497ce0625e43de96e9756e4b89acde"}'
    ></script>
  </head>
  <body>
    <a class="skip btn" href="#main">Skip to content</a>
    <nav class="top"><div>
      <a class="brand" href="/">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect x="1" y="1" width="20" height="20" rx="5" fill="#c2410c"/><path d="M6.2 8.4 9.4 11l-3.2 2.6M11.4 14.4h4.4" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        ErrLookup
      </a>
      <form class="navsearch" role="search" method="get" action="/search/">
        <label class="sr-only" for="nav-q">Search error messages</label>
        <input
          id="nav-q"
          type="search"
          name="q"
          placeholder="Paste an error message…"
          autocomplete="off"
          spellcheck="false"
enterkeyhint="search"
        />
        <button type="submit">Search</button>
      </form>
      <span class="navlinks">
      <a href="/troubleshooting/">Troubleshooting</a>
      <a href="/about/">About</a>
      <a href="/api-docs/">API</a>
      <a class="gh" href="https://github.com/standardbeagle/err-lookup" target="_blank" rel="noopener noreferrer" aria-label="ErrLookup on GitHub">
        <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
      </a>
      </span>
    </div></nav>
    <main id="main">
      <slot />
    </main>
    <footer class="site"><div>
      <span>Built by <a href="https://standardbeagle.com" target="_blank" rel="noopener noreferrer">Standard Beagle</a>, the AI UX agency for bold product teams.</span>
      <a href="/guides/">Guides</a>
      <a href="/blog/">Blog</a>
      <a href="/request-crawl/">Request a crawl</a>
      <a href="https://www.npmjs.com/package/@standardbeagle/errlookup-mcp" target="_blank" rel="noopener noreferrer">MCP server</a>
      <a href="/rss.xml">RSS</a>
      <a href="/llms.txt">llms.txt</a>
      <a href="/data/manifest.json">dataset</a>
      <a href="https://github.com/standardbeagle/err-lookup" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div></footer>
  </body>
</html>
