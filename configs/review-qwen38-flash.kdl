// Review-phase candidate: Qwen3.8 Flash via opencode Go.
// Same 9-record traffic-subset dry-run as the 2026-08-16 and 2026-08-27
// comparisons, so verdict calibration compares directly against glm-5.3,
// glm-5.3-flash (the incumbent) and the Codex three.
// Use with: ERRLOOKUP_CONFIG=configs/review-qwen38-flash.kdl ERRLOOKUP_DB=data/review-subset.db
provider "candidate" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "opencode-go/qwen3.8-flash"
    timeout-ms 600000
    idle-timeout-ms 180000
}
defaults {
    primary "candidate"
    max-concurrent 1
    delay-between-phases-ms 2000
}
