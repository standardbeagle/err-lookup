// Review-phase candidate: GPT-5.6 Sol at low reasoning effort via opencode
// ACP (OpenAI Codex plan). Effort pinned in ~/.config/opencode/opencode.json.
// Use with: ERRLOOKUP_CONFIG=configs/review-codex-sol.kdl
provider "codex-sol" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "openai/gpt-5.6-sol"
    timeout-ms 600000
}
defaults {
    primary "codex-sol"
    max-concurrent 1
    delay-between-phases-ms 2000
}
