// Comparison run: Kimi K2.7 Code via opencode ACP (Kimi For Coding plan).
// Use with: ERRLOOKUP_CONFIG=configs/compare-opencode-kimi.kdl ERRLOOKUP_DB=data/compare-kimi.db
provider "opencode" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "kimi-for-coding/kimi-for-coding"
    timeout-ms 600000
}
defaults {
    primary "opencode"
    max-concurrent 1
    delay-between-phases-ms 2000
}
