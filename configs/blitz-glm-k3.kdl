// Corpus-blitz routing: GLM 5.3 Flash does EVERY phase (switched 2026-08-28;
// filename kept because four ops scripts reference it). The parity ladder in
// docs/model-comparison-2026-08-27-glm53-flash.md put tuned flash at or above
// glm-5.2 on all three comparison repos (22/107/88 records vs 18/82/47) with
// a request-rate cap several times glm-5.2's — same concurrency knobs now buy
// ~3x the usable throughput headroom. glm-5.2 and k3 are removed, not kept as
// fallbacks; glm-5.3 stays only as the verify fallback.
// Use with: ERRLOOKUP_CONFIG=configs/blitz-glm-k3.kdl
//
// Bulk flash runs the step-3 recipe, each knob tied to a measured failure:
//  - reasoningEffort high: thinking:{disabled} maps to an effort model's
//    MINIMUM effort, and low is where the compliance failures lived (empty
//    stubs, answer streamed as text, truncation).
//  - prompt-directive: replaces the stock minimal-thinking opener — complete
//    coverage of every index, brief factual fields, write-tool delivery.
//  - analysis-batch-size 10 (defaults below): half-size outputs cannot hit
//    the truncation ceiling; the rate-limit headroom absorbs the extra calls.
provider "flash" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "zai-coding-plan/glm-5.3-flash"
    timeout-ms 600000
    idle-timeout-ms 180000
    model-options "{\"reasoningEffort\":\"high\"}"
    prompt-directive "Be thorough and complete. Produce an entry for EVERY item asked for — an incomplete answer is a failed answer. Keep each field brief and factual; never pad. Deliver the output exactly as the delivery instruction says, using the write tool, and verify the file holds the complete JSON before finishing."
}
// Review-phase winner of docs/model-comparison-2026-08-27-glm53-flash.md:
// best-calibrated verdicts on the 9-record traffic subset (7 good / 1
// improved / 1 defective, the safe defective stance on grpc-go, targeted
// patches only) at 27s/record. Effort pinned LOW explicitly: it is where that
// calibration was measured, and review's single-record calls never hit the
// low-effort compliance failures the bulk phases saw. Watch item: it
// under-patches subtle single-field defects glm-5.3 caught — omissions,
// never invention.
provider "flash-review" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "zai-coding-plan/glm-5.3-flash"
    timeout-ms 600000
    idle-timeout-ms 180000
    model-options "{\"reasoningEffort\":\"low\"}"
}
// Verify fallback only: records still ship verified if flash is down or
// rate-limit-stormed. Off every primary path since 2026-08-28.
provider "glm53" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "zai-coding-plan/glm-5.3"
    timeout-ms 600000
    idle-timeout-ms 180000
    model-options "{\"thinking\":{\"type\":\"disabled\"}}"
}
// Recording proxy (src/proxy). ON since 2026-09-07: the gate ramp below has
// no other early warning. The pipeline cannot see a 429 — opencode's SDK
// absorbs and retries it — so without the proxy the first sign of a gate set
// too high is the failure breaker tripping, which is late and expensive.
//
// This makes errlookup-proxy.service a hard dependency of every drain: a
// routed call to a dead proxy fails outright. The unit carries
// Restart=always, and errlookup-scan.service now Wants/After it so a boot
// brings the proxy up first. To drop the dependency, set this false — the
// drain goes back to a direct connection and loses the 429 signal with it.
proxy {
    enabled true
    host "127.0.0.1"
    port 8919
    upstream "https://api.z.ai/api/coding/paas/v4"
    provider-ids "zai-coding-plan"
}
defaults {
    primary "flash"
    // 10 -> 4 on 2026-09-07 (user call), measured through the proxy: two ~50
    // minute windows on the same drain gave a 59.1% 429 share at 10 against
    // 0.4% at 4. About 1,300 of gate 10's 1,745 requests bought only latency,
    // and 10 was working the host hard for them.
    //
    // Whether 10 delivered MORE work is still open — successes/min fell 38%,
    // while repo completions across the two windows did not (see
    // docs/provider-proxy-2026-09-07.md). Settling it needs records produced
    // per window, not requests served.
    //
    // RAMP: hold 4 for 2-3 days, then raise one step at a time, watching the
    // 429 share between steps (`errlookup proxy --limits`, or GET
    // /__errlookup/limits). Reset the tally at each step —
    // `errlookup proxy --reset` — or the previous step's counts dilute the
    // new one. A share climbing off ~0 is the signal to stop and step back.
    provider-max-concurrent 4
    // 6 repos in flight: the shared gate caps real provider calls at 10, so
    // extra repos only fill slots left idle by clones, candidate extraction,
    // and assembly — and ls-remote skips make idle workers cheap.
    max-concurrent 6
    batch-concurrency 6
    // Step-3 recipe (see the flash provider note): half-size analysis calls.
    analysis-batch-size 10
    // Off-peak only: the plan bills peak (Mon-Fri 06:00-10:00 UTC) at twice the
    // credit rate, so a long unattended run holds between repos rather than
    // spending double for the same output.
    skip-peak true
    // Half the source window, and the enclosing function's callers in its
    // place. Blind A/B over 21 error sites in three repos (judge glm-5.3):
    // B won 15, A won 4, 2 ties, on prompts 70-80% the size. Express carried
    // no facts at all — lci gives no span for `res.status = function ...` —
    // and the halved window still went 4-2-2 there, so the smaller window
    // stands on its own rather than riding on the facts.
    source-window 6
    call-facts true
    // While never-analyzed repos remain queued, one analysis start in four
    // refreshes an already-published repo; the rest import new ones.
    rescan-share 0.25
    delay-between-phases-ms 2000

    // Recrawl schedule: once nothing is left to import, re-analyze the oldest
    // published repos with the current pipeline. 50/drain against 4 drains a
    // day cycles a ~1,500-repo corpus in roughly a week, and never runs while
    // repos are still waiting for their first analysis.
    backfill-after-days 30
    backfill-batch 50
}
phase-providers {
    review "flash-review"
    // Second opinion for records flash left without documentation or
    // solutions after the verify rounds: full glm-5.3 gets one pass before
    // the record is raised as a data bug (runner verify section).
    verify-escalate "glm53"
}
phase-fallbacks {
    verify "glm53"
}
