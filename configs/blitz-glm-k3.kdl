// Corpus-blitz routing: GLM 5.2 (comparison winner) does the bulk phases over
// pre-extracted candidates; Kimi K3 (strong, pricier) validates.
// Use with: ERRLOOKUP_CONFIG=configs/blitz-glm-k3.kdl
provider "glm" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "zai-coding-plan/glm-5.2"
    timeout-ms 600000
    idle-timeout-ms 180000
    // Bulk classification needs no deliberation: thinking off (Anthropic-shape
    // option — the z.ai coding-plan endpoint is Anthropic-compatible).
    model-options "{\"thinking\":{\"type\":\"disabled\"}}"
}
provider "k3" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "kimi-for-coding/k3"
    // Stalls are caught by idle-timeout-ms (no ACP events), so the wall clock
    // is only a backstop. 600s here killed actively-streaming verify calls on
    // tensorflow-scale batches; 30min lets a busy call finish while a stalled
    // one still dies within 3 minutes.
    timeout-ms 1800000
    idle-timeout-ms 180000
    model-options "{\"thinking\":{\"type\":\"disabled\"}}"
}
// Review-phase winner of docs/model-comparison-2026-08-16-review-phase.md:
// only candidate with a calibrated verdict distribution (says "good", patches
// single fields). 5.3 stays off the bulk phases — it lost that comparison
// (docs/model-comparison-2026-08-14-glm53.md).
provider "glm53" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "zai-coding-plan/glm-5.3"
    timeout-ms 600000
    idle-timeout-ms 180000
    model-options "{\"thinking\":{\"type\":\"disabled\"}}"
}
defaults {
    primary "glm"
    // GLM 5.2 allows 10 concurrent requests, enforced process-wide below. The
    // two knobs deliberately over-subscribe that (3 x 6 = 18 potential): the
    // gate keeps the real ceiling at 10, and the slack means a repo cloning or
    // between phases does not leave provider slots idle.
    provider-max-concurrent 10
    // 6 repos in flight (was 3): the shared gate caps real provider calls at
    // 10, so extra repos only fill slots left idle by clones, candidate
    // extraction, and assembly — and ls-remote skips make idle workers cheap.
    max-concurrent 6
    batch-concurrency 6
    analysis-batch-size 20
    // Off-peak only: the plan bills peak (Mon-Fri 06:00-10:00 UTC) at twice the
    // credit rate, so a long unattended run holds between repos rather than
    // spending double for the same output.
    skip-peak true
    // Half the source window, and the enclosing function's callers in its
    // place. Blind A/B over 21 error sites in three repos (judge glm-5.3):
    // B won 15, A won 4, 2 ties, on prompts 70-80% the size. Express carried
    // no facts at all — lci gives no span for `res.status = function ...` —
    // and the halved window still went 4-2-2 there, so the smaller window
    // stands on its own rather than riding on the facts.
    source-window 6
    call-facts true
    // While never-analyzed repos remain queued, one analysis start in four
    // refreshes an already-published repo; the rest import new ones.
    rescan-share 0.25
    delay-between-phases-ms 2000
}
phase-providers {
    verify "k3"
    review "glm53"
}
// When k3's billing cycle is spent (seen 2026-08-25), verify degrades to
// glm-5.3 — slower, but records still ship verified instead of unpatched.
// runProvider skips the dead k3 after its first cycle-spent answer and
// re-probes it hourly.
phase-fallbacks {
    verify "glm53"
}
