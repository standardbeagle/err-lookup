// Corpus-blitz routing: GLM 5.2 (comparison winner) does the bulk phases over
// pre-extracted candidates; Kimi K3 (strong, pricier) validates.
// Use with: ERRLOOKUP_CONFIG=configs/blitz-glm-k3.kdl
provider "glm" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "zai-coding-plan/glm-5.2"
    timeout-ms 600000
}
provider "k3" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "kimi-for-coding/k3"
    timeout-ms 600000
}
defaults {
    primary "glm"
    // 2 repos x 4 in-phase calls = at most 8 opencode processes, on a 12-core
    // host. Raise batch-concurrency first if the provider tolerates it; the
    // per-phase calls are the long pole, not the repo count.
    max-concurrent 2
    batch-concurrency 4
    analysis-batch-size 20
    delay-between-phases-ms 2000
}
phase-providers {
    verify "k3"
}
