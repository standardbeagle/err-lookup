provider "claude" {
    command "claude"
    args "-p" "--output-format" "json" "--max-turns" "30" "--permission-mode" "acceptEdits"
    timeout-ms 600000
}
provider "opencode" {
    command "opencode"
    args "acp" "--pure"
    type "acp"
    model "kimi-for-coding/kimi-for-coding"
    timeout-ms 600000
}
defaults {
    primary "claude"
    max-concurrent 1
    delay-between-phases-ms 5000
}
