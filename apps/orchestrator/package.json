{
  "name": "orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "analyze": "tsx --env-file=.env src/cli/analyze.ts",
    "batch-analyze": "tsx --env-file=.env src/cli/batch-analyze.ts",
    "multi-analyze": "tsx --env-file=.env src/cli/multi-agent-analyze.ts",
    "batch-multi": "tsx --env-file=.env src/cli/batch-multi-analyze.ts",
    "verify-enhance": "tsx --env-file=.env src/cli/verify-enhance.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@error-schema/core": "workspace:*",
    "@err-lookup/shared": "workspace:*",
    "bullmq": "^5.31.0",
    "drizzle-orm": "^0.38.0",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1",
    "fs-extra": "^11.2.0",
    "execa": "^9.5.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
